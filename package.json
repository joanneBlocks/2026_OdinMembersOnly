{
  "name": "2026_odinmembersonly",
  "version": "1.0.0",
  "description": "Shhh. This club has secrets. Anyone can read the messages, but only real members see who wrote them — and only the admin can make things disappear. A fun full-stack project covering auth, roles, and permissions.",
  "main": "index.js",
  "scripts": {
    "start": "node app.js",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "build:js": "vite build",
    "watch:js": "vite build --watch",
    "dev": "node app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joanneBlocks/2026_OdinMembersOnly.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/joanneBlocks/2026_OdinMembersOnly/issues"
  },
  "homepage": "https://github.com/joanneBlocks/2026_OdinMembersOnly#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.0",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.3"
  }
