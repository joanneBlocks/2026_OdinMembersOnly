<div class="max-w-md mx-auto">
  <div class="mb-8">
    <h1 class="font-serif text-4xl font-bold text-deepPlum mb-2">Welcome Back</h1>
    <p class="text-warmGray text-sm tracking-wide">We've missed you 🌸</p>
  </div>

  <form method="POST" action="/login" class="flex flex-col gap-5">
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">Email</label>
      <input type="email" name="email" class="w-full bg-softBlush border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">Password</label>
      <input type="password" name="password" class="w-full bg-softBlush border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200">
    </div>
    <button type="submit" class="bg-roseGold text-ivory text-sm uppercase tracking-widest py-3 px-6 rounded-btn hover:brightness-110 shadow-glow transition-all duration-200 hover:scale-[1.02] mt-2">
      Login
    </button>
  </form>

  <p class="mt-6 text-sm text-warmGray text-center">
    Don't have an account? <a href="/sign-up" class="text-roseGold hover:underline">Join Us</a>
  </p>
</div>