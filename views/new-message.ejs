<div class="max-w-md mx-auto">
  <div class="mb-8">
    <h1 class="font-serif text-4xl font-bold text-deepPlum mb-2">Share Something</h1>
    <p class="text-warmGray text-sm tracking-wide">Spread light, hope and encouragement 🌸</p>
  </div>

  <% if (error) { %>
    <div class="bg-softBlush border-l-4 border-roseGold rounded-btn p-4 mb-6">
      <p class="text-sm text-roseGold"><%= error %></p>
    </div>
  <% } %>

  <form method="POST" action="/new-message" class="flex flex-col gap-5">
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">Title</label>
      <input type="text" name="title" placeholder="A hopeful thought..." class="w-full bg-softBlush border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200 placeholder-warmGray">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">Message</label>
      <textarea name="text" rows="6" placeholder="Share what's on your heart..." class="w-full bg-softBlush border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200 placeholder-warmGray resize-none"></textarea>
    </div>
    <button type="submit" class="bg-roseGold text-ivory text-sm uppercase tracking-widest py-3 px-6 rounded-btn hover:brightness-110 shadow-glow transition-all duration-200 hover:scale-[1.02] mt-2">
      Post to the Board
    </button>
  </form>
</div>