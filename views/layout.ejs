<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Members Only</title>
  <style>
    body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
    nav { display: flex; gap: 16px; margin-bottom: 32px; border-bottom: 1px solid #ccc; padding-bottom: 16px; }
    nav a { text-decoration: none; color: #333; }
    .error { color: red; font-size: 14px; }
    .message-card { border: 1px solid #ccc; padding: 16px; margin-bottom: 16px; border-radius: 8px; }
    .message-meta { color: #888; font-size: 13px; margin-top: 8px; }
    button { cursor: pointer; }
  </style>
</head>
<body>

  <nav>
    <a href="/">Home</a>
    <% if (currentUser) { %>
      <a href="/new-message">+ New Message</a>
      <a href="/join-club">Join the Club</a>
      <a href="/logout">Logout (<%= currentUser.firstName %>)</a>
    <% } else { %>
      <a href="/sign-up">Sign Up</a>
      <a href="/login">Login</a>
    <% } %>
  </nav>

  <%- body %>

</body>
</html>