<div class="max-w-md mx-auto">
  <div class="mb-8">
    <h1 class="font-serif text-4xl font-bold text-deepPlum dark:text-ivory mb-2">Join Us</h1>
    <p class="text-warmGray text-sm tracking-wide">Begin your journey with House of Hope 🌸</p>
  </div>

  <% if (errors.length > 0) { %>
    <ul class="list-none bg-softBlush dark:bg-dustyMauve border-l-4 border-roseGold rounded-btn p-4 mb-6">
      <% errors.forEach(err => { %>
        <li class="text-sm text-roseGold mb-1 last:mb-0"><%= err.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form method="POST" action="/sign-up" class="flex flex-col gap-5">
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">First Name</label>
      <input type="text" name="firstName" class="w-full bg-softBlush dark:bg-dustyMauve dark:text-ivory border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">Last Name</label>
      <input type="text" name="lastName" class="w-full bg-softBlush dark:bg-dustyMauve dark:text-ivory border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">Email</label>
      <input type="email" name="email" class="w-full bg-softBlush dark:bg-dustyMauve dark:text-ivory border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">Password</label>
      <input type="password" name="password" class="w-full bg-softBlush dark:bg-dustyMauve dark:text-ivory border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-warmGray mb-2">Confirm Password</label>
      <input type="password" name="confirmPassword" class="w-full bg-softBlush dark:bg-dustyMauve dark:text-ivory border border-warmGray border-opacity-30 rounded-btn px-4 py-3 text-sm text-deepPlum focus:outline-none focus:border-roseGold transition-colors duration-200">
    </div>
    <div class="flex items-center gap-3">
      <input type="checkbox" name="isAdmin" id="isAdmin" class="accent-roseGold w-4 h-4">
      <label for="isAdmin" class="text-sm text-warmGray">I am an admin</label>
    </div>
    <button type="submit" class="bg-roseGold text-ivory text-sm uppercase tracking-widest py-3 px-6 rounded-btn hover:brightness-110 shadow-glow transition-all duration-200 hover:scale-[1.02] mt-2">
      Create Account
    </button>
  </form>

  <p class="mt-6 text-sm text-warmGray text-center">
    Already have an account? <a href="/login" class="text-roseGold hover:underline">Login</a>
  </p>
</div>